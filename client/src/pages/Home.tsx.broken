import { useAuth } from "@/_core/hooks/useAuth";
import { trpc } from "@/lib/trpc";
import { Award, BedDouble, BriefcaseBusiness, ChevronDown, CircleUserRound, ConciergeBell, Globe2, KeyRound, LogIn, MapPin, Menu, Palette, Phone, Plane, Search, ShieldCheck, SquareDashed, UserPlus, X } from "lucide-react";
import { FormEvent, useEffect, useMemo, useState } from "react";
import { toast } from "sonner";
import { useLocation } from "wouter";

type EstateProperty = { id: number; name: string; imageUrl: string; bedrooms: number; area: number; price: number; region: string; status: "available" | "reserved" | "sold" };
type EstateAgent = { id: number; fullName: string; phone: string; title: string | null };
const HERO_URL = "/manus-storage/mediterranean-estate_3feb7749.jpg";
const STATUS = { available: "متاح للبيع", reserved: "محجوز", sold: "تم البيع" } as const;
const price = (value: number) => value >= 1_000_000 ? `$${(value / 1_000_000).toFixed(1)}M` : `$${value.toLocaleString("en-US")}`;
const scrollToId = (id: string) => document.getElementById(id)?.scrollIntoView({ behavior: "smooth" });

export default function Home() {
  const [, setLocation] = useLocation();
  const utils = trpc.useUtils();
  const { user, logout } = useAuth();
  const propertiesQuery = trpc.estate.properties.list.useQuery();
  const agentsQuery = trpc.estate.agents.list.useQuery();
  const companyQuery = trpc.estate.company.get.useQuery();
  const properties = propertiesQuery.data as EstateProperty[] | undefined ?? [];
  const agents = agentsQuery.data as EstateAgent[] | undefined ?? [];
  const company = companyQuery.data;
  const featured = useMemo(() => properties.slice(0, 3), [properties]);
  const [selected, setSelected] = useState<EstateProperty | null>(null);
  const [authMode, setAuthMode] = useState<"login" | "register" | null>(null);
  const [mobileOpen, setMobileOpen] = useState(false);
  const [login, setLogin] = useState({ email: "", password: "" });
  const [register, setRegister] = useState({ fullName: "", email: "", password: "" });
  const navigate = (id: string) => { setMobileOpen(false); scrollToId(id); };
  const phoneHref = company?.phone?.replace(/[^+\d]/g, "") || "";
  const whatsapp = company?.whatsapp?.replace(/\D/g, "") || "";

  const loginMutation = trpc.estate.auth.login.useMutation({
    onSuccess: ({ user: nextUser }) => { utils.estate.auth.me.setData(undefined, nextUser); setAuthMode(null); nextUser.role === "admin" ? setLocation("/admin") : navigate("properties"); },
    onError: issue => toast.error(issue.message),
  });
  const registerMutation = trpc.estate.auth.register.useMutation({
    onSuccess: ({ user: nextUser }) => { utils.estate.auth.me.setData(undefined, nextUser); setAuthMode(null); toast.success("تم إنشاء حسابك بصلاحية زائر."); navigate("properties"); },
    onError: issue => toast.error(issue.message),
  });

  useEffect(() => {
    const escape = (event: KeyboardEvent) => { if (event.key === "Escape") { setSelected(null); setAuthMode(null); } };
    document.addEventListener("keydown", escape);
    return () => document.removeEventListener("keydown", escape);
  }, []);

  return (
    <div className="min-h-screen bg-[#050505] text-white" dir="rtl">
      <header className="fixed inset-x-0 top-0 z-40 border-b border-white/[.06] bg-black/50 backdrop-blur-xl">
        <div className="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 lg:px-8">
          <button onClick={() => navigate("home")} className="flex items-center gap-3" aria-label="الرئيسية"><span className="grid h-10 w-10 place-items-center border border-primary/55 font-[family-name:var(--font-display)] text-xl text-primary">P</span><span className="hidden font-[family-name:var(--font-display)] text-xl sm:block">PRESTIGE <span className="text-primary">ESTATES</span></span></button>
          <nav className="hidden gap-9 text-sm text-white/75 lg:flex"><button onClick={() => navigate("home")}>الرئيسية</button><button onClick={() => navigate("properties")}>العقارات</button><button onClick={() => navigate("collections")}>المجموعات</button><button onClick={() => navigate("agents")}>الوكلاء</button><button onClick={() => navigate("contact")}>تواصل</button></nav>
          <div className="flex items-center gap-3">{user?.role === "admin" ? <button onClick={() => setLocation("/admin")} className="btn-outline !px-4 !py-2 text-xs">لوحة المدير</button> : user ? <button onClick={() => logout()} className="btn-outline !px-4 !py-2 text-xs">خروج</button> : <button onClick={() => setAuthMode("login")} className="btn-primary !px-4 !py-2 text-xs">تسجيل الدخول</button>}<button onClick={() => setMobileOpen(true)} className="p-2 lg:hidden" aria-label="فتح القائمة"><Menu /></button></div>
        </div>
      </header>

      <main>
        <section id="home" className="relative flex min-h-screen items-center justify-center overflow-hidden"><img src={HERO_URL} alt="فيلا فاخرة" className="absolute inset-0 h-full w-full object-cover" /><div className="absolute inset-0 bg-gradient-to-b from-black/65 via-black/40 to-[#050505]" /><div className="relative z-10 mx-auto max-w-5xl px-6 pt-16 text-center"><p className="section-label">مرحبًا بكم في Prestige Estates</p><h1 className="mt-6 font-[family-name:var(--font-display)] text-5xl leading-tight sm:text-7xl lg:text-8xl">حيث تلتقي<br /><span className="gold-gradient-text">الفخامة بالإرث</span></h1><p className="mx-auto mt-7 max-w-2xl text-base leading-8 text-gray-300 sm:text-xl">اكتشف عقارات استثنائية مختارة بعناية لمن لا يقبلون بأقل من الكمال.</p><div className="mt-10 flex flex-col justify-center gap-4 sm:flex-row"><button onClick={() => navigate("properties")} className="btn-primary">استكشف العقارات</button><button onClick={() => navigate("contact")} className="btn-outline">تواصل معنا</button></div></div><button onClick={() => navigate("properties")} className="absolute bottom-8 animate-bounce text-primary" aria-label="العقارات"><ChevronDown /></button></section>

        <section className="px-6 py-20"><div className="mx-auto max-w-6xl rounded-2xl border border-primary/15 bg-white/[.035] p-8 md:p-12"><h2 className="text-center font-[family-name:var(--font-display)] text-3xl sm:text-4xl">اعثر على عقارك المثالي</h2><div className="mt-10 grid gap-4 md:grid-cols-4"><SearchSelect label="الموقع" value="كل المواقع" /><SearchSelect label="نوع العقار" value="كل الأنواع" /><SearchSelect label="نطاق السعر" value="أي سعر" /><button onClick={() => navigate("properties")} className="btn-primary h-12 self-end">بحث <Search className="h-4 w-4" /></button></div></div></section>

        <section id="properties" className="px-6 py-20"><div className="mx-auto max-w-7xl"><Heading eyebrow="عقارات حصرية" title="عقارات مميزة" note="انقر على أي بطاقة لعرض التفاصيل داخل المنصة." />{propertiesQuery.error ? <Notice text="تعذر تحميل العقارات الآن. يرجى المحاولة لاحقًا." /> : propertiesQuery.isLoading ? <LoadingCards /> : featured.length ? <div className="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">{featured.map((item, index) => <PropertyCard key={item.id} property={item} index={index} onOpen={() => setSelected(item)} />)}</div> : <Notice text="ننتقي حاليًا مجموعتنا العقارية القادمة." />}</div></section>

        <section id="collections" className="bg-[#111111] px-6 py-20"><div className="mx-auto max-w-7xl"><Heading centered eyebrow="اختيارات منسقة" title="مجموعات حصرية" />{properties.length ? <div className="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">{properties.slice(0, 4).map((item, index) => <button key={item.id} onClick={() => setSelected(item)} className="group relative h-80 overflow-hidden rounded-xl text-right"><img src={item.imageUrl} alt={item.name} className="h-full w-full object-cover transition duration-700 group-hover:scale-110" /><div className="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent" /><div className="absolute inset-x-0 bottom-0 p-6"><p className="font-[family-name:var(--font-display)] text-xl">{item.name}</p><p className="mt-1 text-sm text-white/65">مجموعة مختارة {index + 1}</p></div></button>)}</div> : <Notice text="تُجهّز المجموعة الحصرية لتظهر قريبًا." />}</div></section>

        <section className="px-6 py-20"><div className="mx-auto max-w-7xl"><Heading centered eyebrow="ميزتنا" title="لماذا Prestige Estates" /><div className="mt-14 grid gap-8 md:grid-cols-3"><Advantage icon={Globe2} title="انتشار دولي" text="وصول منتقى إلى وجهات عقارية مميزة مع فهم لخصوصية كل سوق." /><Advantage icon={ShieldCheck} title="خصوصية تامة" text="تجربة تملك تراعي السرية والخصوصية في كل تفاصيل التواصل." /><Advantage icon={Award} title="خبرة سوقية" text="رؤية عملية تساعدك على تقييم العقار واتخاذ القرار بثقة." /></div></div></section>
        <section className="bg-[#111111] px-6 py-20"><div className="mx-auto grid max-w-7xl grid-cols-2 gap-6 md:grid-cols-4"><Stat value={properties.length || "—"} label="عقارًا مختارًا" /><Stat value="24/7" label="تواصل خاص" /><Stat value="12" label="وجهة مميزة" /><Stat value="100%" label="اهتمام بالتفاصيل" /></div></section>
        <section id="services" className="px-6 py-20"><div className="mx-auto max-w-7xl"><Heading centered eyebrow="ما نقدمه" title="خدمات فاخرة" /><div className="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3"><Service icon={BriefcaseBusiness} title="استشارات التملك" text="رحلة خاصة لاختيار العقار الأنسب وفق احتياجاتك." /><Service icon={ShieldCheck} title="إدارة العقارات" text="عناية تشغيلية تحفظ قيمة العقار وتبقي التفاصيل تحت السيطرة." /><Service icon={Palette} title="التصميم الداخلي" text="ربطك بخبرات تصميم ترفع من جودة المساحة وتجربتها." /><Service icon={Plane} title="خدمات الانتقال" text="مساندة دقيقة للانتقال وترتيب متطلبات البداية." /><Service icon={ConciergeBell} title="خدمة كونسيرج" text="تنسيق شخصي لخدمات تتجاوز حدود العقار." /><Service icon={Globe2} title="فرص عالمية" text="تجارب تملك متنوعة ضمن أسواق مختارة بعناية." /></div></div></section>

        <section id="all-properties" className="bg-[#111111] px-6 py-20"><div className="mx-auto max-w-7xl"><Heading eyebrow="كل العقارات" title="اكتشف المجموعة الكاملة" note={`${properties.length} عقار`} />{properties.length > 3 ? <div className="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">{properties.slice(3).map((item, index) => <PropertyCard key={item.id} property={item} index={index} onOpen={() => setSelected(item)} />)}</div> : null}</div></section>
        <section id="agents" className="px-6 py-20"><div className="mx-auto max-w-7xl"><Heading centered eyebrow="خبرات خاصة" title="فريق الوكلاء" />{agents.length ? <div className="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{agents.map(agent => <article key={agent.id} className="rounded-xl border border-white/[.08] bg-[#161616] p-6"><div className="flex items-center gap-4"><span className="grid h-12 w-12 place-items-center rounded-full border border-primary/30 font-[family-name:var(--font-display)] text-lg text-primary">{agent.fullName[0]}</span><div><h3 className="font-[family-name:var(--font-display)] text-xl">{agent.fullName}</h3><p className="text-sm text-muted">{agent.title || "مستشار عقاري"}</p></div></div><a href={`tel:${agent.phone.replace(/[^+\d]/g, "")}`} className="mt-6 flex items-center gap-2 text-sm text-primary"><Phone className="h-4 w-4" />{agent.phone}</a></article>)}</div> : <Notice text="يُتاح قريبًا فريق من المستشارين المتخصصين لتقديم تجربة تملك شخصية." />}</div></section>
        <section id="contact" className="px-6 py-20"><div className="mx-auto max-w-5xl rounded-2xl border border-primary/15 bg-[#161616] p-8 text-center sm:p-14"><p className="section-label">استشارة خاصة</p><h2 className="mt-3 font-[family-name:var(--font-display)] text-4xl sm:text-5xl">هل وجدت عقارًا يلفت انتباهك؟</h2><p className="mx-auto mt-6 max-w-2xl leading-8 text-muted">يسعد فريقنا بتنسيق استشارة خاصة والإجابة عن أسئلتك حول كل عقار.</p><div className="mt-9 flex flex-wrap justify-center gap-4">{phoneHref ? <a href={`tel:${phoneHref}`} className="btn-primary"><Phone className="h-4 w-4" />اتصال مباشر</a> : null}{whatsapp ? <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noreferrer" className="btn-outline">تواصل عبر واتساب</a> : null}{!phoneHref && !whatsapp ? <button onClick={() => setAuthMode("register")} className="btn-primary">ابدأ تواصلك معنا</button> : null}</div></div></section>
      </main>
      <Footer companyName={company?.companyName || "PRESTIGE ESTATES"} phone={company?.phone || ""} phoneHref={phoneHref} whatsapp={whatsapp} navigate={navigate} />
      {mobileOpen ? <MobileMenu close={() => setMobileOpen(false)} navigate={navigate} /> : null}
      {selected ? <PropertyDetail property={selected} allProperties={properties} agents={agents} close={() => setSelected(null)} select={setSelected} /> : null}
      {authMode ? <AuthModal mode={authMode} close={() => setAuthMode(null)} login={login} setLogin={setLogin} register={register} setRegister={setRegister} pending={loginMutation.isPending || registerMutation.isPending} onLogin={event => { event.preventDefault(); loginMutation.mutate(login); }} onRegister={event => { event.preventDefault(); registerMutation.mutate(register); }} switchMode={() => setAuthMode(authMode === "login" ? "register" : "login")} /> : null}
    </div>
  );
}

function Heading({ eyebrow, title, note, centered = false }: { eyebrow: string; title: string; note?: string; centered?: boolean }) { return <div className={centered ? "text-center" : "flex flex-col gap-3 md:flex-row md:items-end md:justify-between"}><div><p className="section-label">{eyebrow}</p><h2 className="mt-3 font-[family-name:var(--font-display)] text-4xl sm:text-5xl">{title}</h2>{centered ? <div className="gold-hairline mx-auto mt-6 h-px w-16" /> : null}</div>{note ? <p className={centered ? "mt-4 text-sm text-muted" : "max-w-sm text-sm leading-7 text-muted"}>{note}</p> : null}</div>; }
function SearchSelect({ label, value }: { label: string; value: string }) { return <label><span className="mb-2 block text-xs text-muted">{label}</span><span className="flex h-12 items-center justify-between rounded-lg border border-white/10 bg-black/20 px-4 text-sm text-white/70">{value}<ChevronDown className="h-4 w-4 text-primary" /></span></label>; }
function Notice({ text }: { text: string }) { return <div className="mt-12 rounded-xl border border-primary/15 bg-primary/[.035] px-6 py-10 text-center text-sm leading-7 text-muted">{text}</div>; }
function LoadingCards() { return <div className="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">{[1, 2, 3].map(item => <div key={item} className="animate-pulse overflow-hidden rounded-xl bg-[#161616]"><div className="h-72 bg-white/[.04]" /><div className="space-y-4 p-6"><div className="h-5 w-2/3 bg-white/[.08]" /><div className="h-3 w-1/2 bg-white/[.05]" /></div></div>)}</div>; }
function PropertyCard({ property, index, onOpen }: { property: EstateProperty; index: number; onOpen: () => void }) { return <button onClick={onOpen} className="property-card group overflow-hidden rounded-xl bg-[#161616] text-right" style={{ transitionDelay: `${index * 80}ms` }}><div className="relative h-72 overflow-hidden"><img src={property.imageUrl} alt={property.name} className="property-img h-full w-full object-cover" /><div className="property-overlay absolute inset-0 grid place-items-center bg-black/45"><span className="btn-primary text-sm">عرض التفاصيل</span></div><span className="absolute left-4 top-4 rounded border border-primary/30 bg-primary/15 px-3 py-1 text-xs text-primary">{STATUS[property.status]}</span></div><div className="p-6"><h3 className="font-[family-name:var(--font-display)] text-xl">{property.name}</h3><p className="mt-3 flex items-center gap-2 text-sm text-muted"><MapPin className="h-4 w-4" />{property.region}</p><div className="mt-4 flex gap-4 text-sm text-muted"><span className="flex items-center gap-1"><BedDouble className="h-4 w-4" />{property.bedrooms}</span><span className="flex items-center gap-1"><SquareDashed className="h-4 w-4" />{property.area.toLocaleString()} قدم²</span></div><p className="mt-5 font-[family-name:var(--font-display)] text-2xl text-primary">{price(Number(property.price))}</p></div></button>; }
function Advantage({ icon: Icon, title, text }: { icon: typeof Globe2; title: string; text: string }) { return <article><span className="grid h-14 w-14 place-items-center border border-primary/30 text-primary"><Icon className="h-6 w-6" /></span><h3 className="mt-6 font-[family-name:var(--font-display)] text-2xl">{title}</h3><p className="mt-4 leading-8 text-muted">{text}</p></article>; }
function Stat({ value, label }: { value: string | number; label: string }) { return <div className="rounded-xl border border-primary/10 bg-[#161616] p-7 text-center"><p className="font-[family-name:var(--font-display)] text-4xl text-primary">{value}</p><p className="mt-2 text-xs tracking-wider text-muted">{label}</p></div>; }
function Service({ icon: Icon, title, text }: { icon: typeof Globe2; title: string; text: string }) { return <article className="rounded-xl border border-white/[.06] p-8 transition hover:border-primary/30 hover:bg-[#161616]"><Icon className="h-10 w-10 text-muted" /><h3 className="mt-6 font-[family-name:var(--font-display)] text-xl">{title}</h3><p className="mt-3 text-sm leading-7 text-muted">{text}</p></article>; }

function PropertyDetail({ property, allProperties, agents, close, select }: { property: EstateProperty; allProperties: EstateProperty[]; agents: EstateAgent[]; close: () => void; select: (property: EstateProperty) => void }) {
  const [activeImage, setActiveImage] = useState(property.imageUrl);
  const gallery = [property, ...allProperties.filter(item => item.id !== property.id).slice(0, 3)];
  const similar = allProperties.filter(item => item.id !== property.id).slice(0, 3);
  const agent = agents[0];
  useEffect(() => setActiveImage(property.imageUrl), [property.id, property.imageUrl]);
  return <div className="fixed inset-0 z-[70] overflow-y-auto bg-black/90 p-4 backdrop-blur-sm" role="dialog" aria-modal="true"><div className="relative mx-auto my-4 max-w-6xl rounded-xl border border-white/10 bg-[#111111]"><button onClick={close} className="absolute left-5 top-5 z-10 grid h-10 w-10 place-items-center rounded-full bg-black/70 text-white hover:bg-primary hover:text-black" aria-label="إغلاق"><X className="h-5 w-5" /></button><div className="p-5 pt-16 sm:p-8 sm:pt-16"><div className="grid gap-4 lg:grid-cols-3"><div className="min-h-[350px] overflow-hidden rounded-xl lg:col-span-2 lg:min-h-[500px]"><img src={activeImage} alt={property.name} className="h-full w-full object-cover" /></div><div className="grid grid-cols-2 gap-4 lg:grid-cols-1">{gallery.slice(1).map(item => <button key={item.id} onClick={() => setActiveImage(item.imageUrl)} className="h-40 overflow-hidden rounded-xl border border-transparent hover:border-primary lg:h-[156px]"><img src={item.imageUrl} alt={item.name} className="h-full w-full object-cover" /></button>)}</div></div><div className="mt-10 grid gap-12 lg:grid-cols-3"><div className="lg:col-span-2"><div className="flex flex-wrap items-start justify-between gap-6"><div><p className="section-label">{STATUS[property.status]}</p><h2 className="mt-3 font-[family-name:var(--font-display)] text-4xl sm:text-5xl">{property.name}</h2><p className="mt-3 flex items-center gap-2 text-muted"><MapPin className="h-4 w-4 text-primary" />{property.region}</p></div><p className="font-[family-name:var(--font-display)] text-4xl text-primary">{price(Number(property.price))}</p></div><div className="my-8 grid grid-cols-3 gap-4 border-y border-white/10 py-6"><Metric icon={BedDouble} value={property.bedrooms} label="غرف نوم" /><Metric icon={SquareDashed} value={property.area.toLocaleString()} label="قدم مربع" /><Metric icon={Award} value="مختار" label="عقار مميز" /></div><h3 className="font-[family-name:var(--font-display)] text-2xl">عن هذا العقار</h3><p className="mt-4 leading-8 text-muted">تجمع هذه الوجهة بين جودة الموقع وهدوء الخصوصية والتصميم الذي يوازن بين الفخامة المعاصرة والراحة اليومية. تواصل معنا للحصول على تفاصيل الاستشارة والمعاينة.</p><h3 className="mt-9 font-[family-name:var(--font-display)] text-2xl">المزايا</h3><div className="mt-4 grid gap-3 sm:grid-cols-3">{["موقع استثنائي", "تشطيبات راقية", "تجربة معاينة خاصة"].map(item => <div key={item} className="flex items-center gap-3 rounded-lg bg-[#161616] p-4 text-sm"><ShieldCheck className="h-4 w-4 text-primary" />{item}</div>)}</div><DetailPanel title="مخطط المساحة" icon={SquareDashed} value={`${property.area.toLocaleString()} قدم²`} note="المساحة الإجمالية للعقار" /><DetailPanel title="الموقع" icon={MapPin} value={property.region} note="استكشف الحي عند ترتيب معاينة خاصة." /></div><aside className="h-fit rounded-xl border border-primary/15 bg-[#161616] p-6"><h3 className="font-[family-name:var(--font-display)] text-xl">هل يهمك هذا العقار؟</h3><p className="mt-3 text-sm leading-7 text-muted">سيرافقك مستشارنا في خطوة المعاينة واختيار التفاصيل المناسبة.</p>{agent ? <div className="mt-6 border-t border-white/10 pt-5"><p className="text-[10px] tracking-[.18em] text-primary">مستشار العقار</p><p className="mt-2 font-[family-name:var(--font-display)] text-lg">{agent.fullName}</p><p className="text-sm text-muted">{agent.title || "مستشار عقاري"}</p><a href={`tel:${agent.phone.replace(/[^+\d]/g, "")}`} className="mt-3 flex items-center gap-2 text-sm text-primary"><Phone className="h-4 w-4" />{agent.phone}</a></div> : null}<button onClick={close} className="btn-primary mt-6 w-full">طلب استشارة</button><button onClick={close} className="btn-outline mt-3 w-full">العودة للعقارات</button></aside></div>{similar.length ? <section className="mt-14 border-t border-white/10 pt-10"><h3 className="font-[family-name:var(--font-display)] text-3xl">عقارات مشابهة</h3><div className="mt-6 grid gap-4 sm:grid-cols-3">{similar.map(item => <button key={item.id} onClick={() => select(item)} className="overflow-hidden rounded-xl border border-white/[.08] text-right hover:border-primary/40"><img src={item.imageUrl} alt={item.name} className="h-36 w-full object-cover" /><div className="p-4"><p className="font-[family-name:var(--font-display)]">{item.name}</p><p className="mt-1 text-sm text-primary">{price(Number(item.price))}</p></div></button>)}</div></section> : null}</div></div></div></div>;
}

function Metric({ icon: Icon, value, label }: { icon: typeof BedDouble; value: string | number; label: string }) { return <div className="text-center"><Icon className="mx-auto h-5 w-5 text-primary" /><p className="mt-2 font-[family-name:var(--font-display)] text-2xl">{value}</p><p className="text-xs text-muted">{label}</p></div>; }
function DetailPanel({ title, icon: Icon, value, note }: { title: string; icon: typeof MapPin; value: string; note: string }) { return <section className="mt-9"><h3 className="font-[family-name:var(--font-display)] text-2xl">{title}</h3><div className="mt-4 flex min-h-48 items-center justify-center rounded-xl bg-[#161616] text-center"><div><Icon className="mx-auto h-10 w-10 text-primary" /><p className="mt-4 font-[family-name:var(--font-display)] text-2xl">{value}</p><p className="mt-1 text-sm text-muted">{note}</p></div></div></section>; }
function Footer({ companyName, phone, phoneHref, whatsapp, navigate }: { companyName: string; phone: string; phoneHref: string; whatsapp: string; navigate: (id: string) => void }) { return <footer className="border-t border-white/[.06] bg-[#111111] px-6 py-16"><div className="mx-auto grid max-w-7xl gap-10 md:grid-cols-2 lg:grid-cols-4"><div><div className="flex items-center gap-3"><span className="grid h-10 w-10 place-items-center border border-primary/50 font-[family-name:var(--font-display)] text-xl text-primary">P</span><span className="font-[family-name:var(--font-display)] text-xl">PRESTIGE <span className="text-primary">ESTATES</span></span></div><p className="mt-6 text-sm leading-7 text-muted">نقدّم تجربة عقارية تركز على الاستثنائية والخصوصية والاهتمام بكل تفصيل.</p></div><FooterLinks title="روابط سريعة" items={["العقارات", "عن الشركة", "الوكلاء", "تواصل معنا"]} click={item => navigate(item === "العقارات" ? "properties" : item === "عن الشركة" ? "services" : item === "الوكلاء" ? "agents" : "contact")} /><FooterLinks title="خدماتنا" items={["استشارات التملك", "إدارة العقارات", "تصميم داخلي", "خدمات كونسيرج"]} click={() => navigate("services")} /><div><h3 className="font-[family-name:var(--font-display)] text-lg">تواصل خاص</h3><p className="mt-5 text-sm leading-7 text-muted">تواصل معنا للحصول على استشارة تليق بتطلعاتك.</p>{phoneHref ? <a href={`tel:${phoneHref}`} className="mt-4 flex items-center gap-2 text-sm text-primary"><Phone className="h-4 w-4" />{phone}</a> : null}{whatsapp ? <a href={`https://wa.me/${whatsapp}`} className="mt-3 block text-sm text-primary">واتساب</a> : null}</div></div><div className="mx-auto mt-12 flex max-w-7xl flex-col items-center justify-between gap-3 border-t border-white/[.06] pt-7 text-xs tracking-wide text-muted sm:flex-row"><p>© 2026 {companyName}. جميع الحقوق محفوظة.</p><p>صُممت بعناية لخدمة العقارات الاستثنائية.</p></div></footer>; }
function FooterLinks({ title, items, click }: { title: string; items: string[]; click: (item: string) => void }) { return <div><h3 className="font-[family-name:var(--font-display)] text-lg">{title}</h3><div className="mt-5 flex flex-col gap-3">{items.map(item => <button key={item} onClick={() => click(item)} className="w-fit text-right text-sm text-muted hover:text-primary">{item}</button>)}</div></div>; }
function MobileMenu({ close, navigate }: { close: () => void; navigate: (id: string) => void }) { return <div className="fixed inset-0 z-[60] bg-[#050505] p-8 lg:hidden"><div className="flex items-center justify-between"><span className="font-[family-name:var(--font-display)] text-xl">PRESTIGE <span className="text-primary">ESTATES</span></span><button onClick={close} aria-label="إغلاق"><X /></button></div><div className="mt-16 flex flex-col gap-6 font-[family-name:var(--font-display)] text-3xl"><button onClick={() => navigate("home")} className="text-right">الرئيسية</button><button onClick={() => navigate("properties")} className="text-right">العقارات</button><button onClick={() => navigate("collections")} className="text-right">المجموعات</button><button onClick={() => navigate("agents")} className="text-right">الوكلاء</button><button onClick={() => navigate("contact")} className="text-right">تواصل</button></div></div>; }
function AuthModal({ mode, close, login, setLogin, register, setRegister, pending, onLogin, onRegister, switchMode }: { mode: "login" | "register"; close: () => void; login: { email: string; password: string }; setLogin: (value: { email: string; password: string }) => void; register: { fullName: string; email: string; password: string }; setRegister: (value: { fullName: string; email: string; password: string }) => void; pending: boolean; onLogin: (event: FormEvent<HTMLFormElement>) => void; onRegister: (event: FormEvent<HTMLFormElement>) => void; switchMode: () => void }) { const isLogin = mode === "login"; return <div className="fixed inset-0 z-[80] grid place-items-center bg-black/80 p-4 backdrop-blur-sm" role="dialog" aria-modal="true"><div className="relative w-full max-w-md rounded-2xl border border-primary/20 bg-[#111111] p-7 sm:p-9"><button onClick={close} className="absolute left-5 top-5 text-muted hover:text-white" aria-label="إغلاق"><X className="h-5 w-5" /></button><span className="grid h-11 w-11 place-items-center border border-primary/40 text-primary">{isLogin ? <KeyRound className="h-5 w-5" /> : <UserPlus className="h-5 w-5" />}</span><p className="section-label mt-6">Prestige Estates</p><h2 className="mt-2 font-[family-name:var(--font-display)] text-3xl">{isLogin ? "أهلاً بعودتك" : "أنشئ حسابك"}</h2>{isLogin ? <form className="mt-7 space-y-4" onSubmit={onLogin}><input className="input-luxury" type="email" value={login.email} onChange={event => setLogin({ ...login, email: event.target.value })} placeholder="البريد الإلكتروني" required /><input className="input-luxury" type="password" value={login.password} onChange={event => setLogin({ ...login, password: event.target.value })} placeholder="كلمة السر" required /><button className="btn-primary w-full" disabled={pending}>{pending ? "جارٍ التحقق..." : "تسجيل الدخول"}<LogIn className="h-4 w-4" /></button></form> : <form className="mt-7 space-y-4" onSubmit={onRegister}><input className="input-luxury" value={register.fullName} onChange={event => setRegister({ ...register, fullName: event.target.value })} placeholder="الاسم الكامل" required /><input className="input-luxury" type="email" value={register.email} onChange={event => setRegister({ ...register, email: event.target.value })} placeholder="البريد الإلكتروني" required /><input className="input-luxury" type="password" minLength={6} value={register.password} onChange={event => setRegister({ ...register, password: event.target.value })} placeholder="كلمة السر" required /><button className="btn-primary w-full" disabled={pending}>{pending ? "جارٍ إنشاء الحساب..." : "إنشاء حساب"}<CircleUserRound className="h-4 w-4" /></button></form>}<p className="mt-6 text-center text-xs text-muted">{isLogin ? "ليس لديك حساب؟" : "لديك حساب؟"} <button onClick={switchMode} className="font-bold text-primary">{isLogin ? "أنشئ حسابًا" : "تسجيل الدخول"}</button></p></div></div>; }
